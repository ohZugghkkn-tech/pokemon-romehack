# SoulGold Vivid Relief: ScaleFX -> Bevel -> Image Adjustment
shaders = 8

shader0 = upstream/stock.slang
alias0 = refpass
filter_linear0 = "false"

shader1 = upstream/edge-smoothing/scalefx/shaders/scalefx-pass0.slang
filter_linear1 = false
scale_type1 = source
scale1 = 1.0
float_framebuffer1 = true
alias1 = scalefx_pass0

shader2 = upstream/edge-smoothing/scalefx/shaders/scalefx-pass1.slang
filter_linear2 = false
scale_type2 = source
scale2 = 1.0
float_framebuffer2 = true

shader3 = upstream/edge-smoothing/scalefx/shaders/scalefx-pass2.slang
filter_linear3 = false
scale_type3 = source
scale3 = 1.0

shader4 = upstream/edge-smoothing/scalefx/shaders/scalefx-pass3.slang
filter_linear4 = false
scale_type4 = source
scale4 = 1.0

shader5 = upstream/edge-smoothing/scalefx/shaders/scalefx-pass4.slang
filter_linear5 = false
scale_type5 = source
scale5 = 3.0

# Render Bevel at output size; keep that size through the final color pass.
shader6 = upstream/handheld/shaders/bevel.slang
filter_linear6 = false
scale_type6 = viewport
scale6 = 1.0

shader7 = upstream/misc/shaders/image-adjustment.slang
filter_linear7 = false
scale_type7 = source
scale7 = 1.0

parameters = "BEVEL_LEVEL;ia_saturation"
BEVEL_LEVEL = 0.10
ia_saturation = 1.20
